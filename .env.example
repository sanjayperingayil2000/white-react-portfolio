# Copy to .env.local and fill in. .env.local is gitignored.

# Contact form — EmailJS (sent from the browser; these three values are public by design).
# Find them at https://dashboard.emailjs.com: Email Services → Service ID,
# Email Templates → Template ID, Account → General → Public Key.
# The template can use {{name}}, {{email}}, {{subject}}, {{message}} (and {{project}}, same as message).
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
